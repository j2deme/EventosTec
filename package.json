{
  "name": "eventostec",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de control de asistencias para institución educativa.",
  "main": "index.js",
  "scripts": {
    "test": "jest --config=jest.config.js --runInBand",
    "test:watch": "jest --config=jest.config.js --watch",
    "build:static": "npm run vendor && npm run build:css",
    "vendor": "node scripts/vendor_static.mjs",
    "build:css": "tailwindcss -i app/static/css/tailwind.input.css -o app/static/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i app/static/css/tailwind.input.css -o app/static/css/tailwind.css --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@tabler/icons-webfont": "3.49.0",
    "@testing-library/dom": "^8.20.0",
    "alpinejs": "3.17.4",
    "dayjs": "1.11.23",
    "jest": "29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tailwindcss": "3.4.17",
    "toastify-js": "1.12.0"
  },
  "dependencies": {
    "tree-sitter-cli": "^0.25.9"
  }
}
